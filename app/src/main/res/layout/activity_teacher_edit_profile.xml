<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pic16"
    tools:context=".screens.Teacher_edit_profile">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="180dp"
        android:paddingEnd="30dp"
        android:paddingBottom="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_TeacherProfile"
            android:layout_width="85dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:layout_marginBottom="30dp"
            app:srcCompat="@drawable/profil" />

        <EditText
            android:id="@+id/profile_Teacher_E_Fname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/gevret_levin_alef"
            android:gravity="end"
            android:hint="שם פרטי"
            android:inputType="text"
            android:textColor="#1E5A7A"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/profile_Teacher_E_Lname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/gevret_levin_alef"
            android:gravity="end"
            android:hint="שם משפחה"
            android:inputType="text"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/profile_Teacher_E_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/gevret_levin_alef"
            android:gravity="end"
            android:hint="גיל"
            android:inputType="number"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/gevret_levin_alef"
            android:gravity="end"
            android:text="כיתות לימוד:"
            android:textColor="#1E5A7A"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/sp_teachclass_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:entries="@array/Arrgrade"
            android:layoutDirection="rtl" />

        <EditText
            android:id="@+id/profile_Teacher_E_teachclass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:fontFamily="@font/gevret_levin_alef"
            android:gravity="end"
            android:hint="כיתות שנבחרו"
            android:textColor="#1E5A7A"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/profile_Teacher_E_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/gevret_levin_alef"
            android:gravity="end"
            android:hint="מחיר"
            android:inputType="numberDecimal"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/gevret_levin_alef"
            android:gravity="end"
            android:text="מקצוע:"
            android:textColor="#1E5A7A"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/sp_subject_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:entries="@array/Arrsubject"
            android:layoutDirection="rtl" />

        <EditText
            android:id="@+id/profile_Teacher_E_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:fontFamily="@font/gevret_levin_alef"
            android:gravity="end"
            android:hint="מקצועות שנבחרו"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/profile_Teacher_E_zoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/gevret_levin_alef"
            android:gravity="end"
            android:hint="זום (yes/no)"
            android:inputType="text"
            android:textSize="17sp" />

        <Button
            android:id="@+id/profile_Teacher_E_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/my_button_background"
            android:fontFamily="@font/gevret_levin_alef"
            android:text="שמור פרופיל"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
