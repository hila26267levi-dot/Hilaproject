<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screens.Student_edit_profile">

    <ImageView
        android:id="@+id/adutpic"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/adutpic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/img_StudentProfile"
        android:layout_width="176dp"
        android:layout_height="0dp"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="21dp"
        app:layout_constraintBottom_toTopOf="@+id/profile_student_E_Fname"
        app:layout_constraintEnd_toEndOf="@+id/profile_student_E_Fname"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/profil" />

    <EditText
        android:id="@+id/profile_student_E_Fname"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:hint="שם פרטי"
        android:textColor="#1E5A7A"
        android:textSize="17dp"
        app:layout_constraintBottom_toTopOf="@+id/profile_student_E_Lname"
        app:layout_constraintEnd_toEndOf="@+id/profile_student_E_Lname"
        app:layout_constraintStart_toStartOf="@+id/profile_student_E_Lname"
        app:layout_constraintTop_toBottomOf="@+id/img_StudentProfile" />

    <EditText
        android:id="@+id/profile_student_E_class"
        android:layout_width="209dp"
        android:layout_height="0dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="75dp"
        android:ems="10"
        android:fontFamily="@font/gevret_levin_alef"
        android:hint="כיתה"
        android:inputType="text"
        android:textColor="#1E5A7A"
        android:textSize="17dp"
        app:layout_constraintBottom_toTopOf="@+id/profile_student_E_phone"
        app:layout_constraintEnd_toEndOf="@+id/profile_student_E_Lname"
        app:layout_constraintTop_toBottomOf="@+id/profile_student_E_Lname" />

    <EditText
        android:id="@+id/profile_student_E_phone"
        android:layout_width="202dp"
        android:layout_height="0dp"
        android:layout_marginEnd="69dp"
        android:layout_marginBottom="75dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:hint="מספר טלפון"
        android:textSize="17dp"
        app:layout_constraintBottom_toTopOf="@+id/btnSaveprofile_student"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_student_E_class" />

    <EditText
        android:id="@+id/profile_student_E_Lname"
        android:layout_width="209dp"
        android:layout_height="0dp"
        android:layout_marginEnd="69dp"
        android:layout_marginBottom="13dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:hint="שם משפחה"
        android:textSize="17dp"
        app:layout_constraintBottom_toTopOf="@+id/profile_student_E_class"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_student_E_Fname" />

    <Button
        android:id="@+id/btnSaveprofile_student"
        android:layout_width="151dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginBottom="159dp"
        android:background="@drawable/my_button_background"
        android:fontFamily="@font/gevret_levin_alef"
        android:text="שמור פרופיל"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_student_E_phone" />
</androidx.constraintlayout.widget.ConstraintLayout>