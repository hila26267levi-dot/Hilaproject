<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- מצב לחיצה -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0D47A1"/> <!-- כחול כהה יותר בלחיצה -->
            <corners android:radius="20dp"/>
            <stroke android:width="2dp" android:color="#42A5F5"/> <!-- קו כחול בהיר -->
        </shape>
    </item>

    <!-- מצב רגיל -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E649D"/> <!-- כחול רגיל -->
            <corners android:radius="20dp"/>
            <stroke android:width="2dp" android:color="#69A6E4"/> <!-- קו כחול בהיר -->
        </shape>
    </item>

</selector>
