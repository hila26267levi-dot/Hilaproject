<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screens.RegisterTeacherActivity">


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="#D7EEF4"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView8"
                android:layout_width="357dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:srcCompat="@drawable/teacher" />

            <ImageView
                android:id="@+id/imageView9"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:srcCompat="@drawable/profil" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="363dp"
            android:layout_height="510dp"
            android:layout_marginLeft="50dp"
            android:background="@color/white"
            android:orientation="vertical"
            tools:layout_editor_absoluteX="31dp"
            tools:layout_editor_absoluteY="274dp">


            <EditText
                android:id="@+id/et_teacher_fname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="שם פרטי"
                android:inputType="text" />

            <EditText
                android:id="@+id/et_teacher_lname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="שם משפחה"
                android:inputType="text" />

            <EditText
                android:id="@+id/et_teacher_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="טלפון"
                android:inputType="phone" />


            <EditText
                android:id="@+id/et_teacher_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="אימייל"
                android:inputType="text" />

            <EditText
                android:id="@+id/et_teacher_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="סיסמא"
                android:inputType="text" />


            <EditText
                android:id="@+id/et_teacher_age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="גיל"
                android:inputType="text" />


            <EditText
                android:id="@+id/et_teacher_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="מחיר"
                android:inputType="text" />


            <Spinner
                android:id="@+id/spSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/Arrsubject" />

            <EditText
                android:id="@+id/etSubjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="text"
                android:text="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="זום"
                    android:text="זום"
                    android:textSize="17dp" />

                <RadioGroup
                    android:id="@+id/zoomYesNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbYes"
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:text="כן" />

                    <RadioButton
                        android:id="@+id/rbNo"
                        android:layout_width="89dp"
                        android:layout_height="wrap_content"
                        android:text="לא" />
                </RadioGroup>
            </LinearLayout>


            <Spinner
                android:id="@+id/et_teacher_teach_class"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:entries="@array/Arrgrade"
                android:hint="כיתות לימוד"
                android:inputType="text" />


            <Button
                android:id="@+id/btn_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="הרשמה" />


        </LinearLayout>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>