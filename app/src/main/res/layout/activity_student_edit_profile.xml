<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D7EEF4"
    tools:context=".screens.Student_edit_profile">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- שני כפתורים בדיוק כמו בהרשמה -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="80dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- כפתור מצלמה - לחיץ - add -->
                <ImageButton
                    android:id="@+id/img_gallery_StudentProfile"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/gallery"
                    android:contentDescription="בחר תמונה"
                    android:scaleType="center"
                    android:src="@null" />

                <!-- עיגול כובע - עיצוב בלבד - add2 -->

                <ImageButton
                    android:id="@+id/img_camara_StudentProfile"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/add"
                    android:contentDescription="בחר תמונה"
                    android:scaleType="center"
                    android:src="@null" />

                <ImageView
                    android:id="@+id/iv_Estudent"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    tools:srcCompat="@tools:sample/avatars" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="עריכת פרופיל תלמיד"
                android:layout_marginTop="20dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1a5f78"
                android:gravity="center"
                android:fontFamily="@font/gevret_levin_alef"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_background"
                android:padding="16dp">

                <!-- שם פרטי -->
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_person"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/profile_student_E_Fname"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="שם פרטי"
                        android:textDirection="ltr"
                        android:inputType="text"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:layoutDirection="rtl"
                        android:textSize="14sp"
                        android:textColor="#1E5A7A"
                        android:fontFamily="@font/gevret_levin_alef" />

                </LinearLayout>

                <!-- שם משפחה -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_person"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/profile_student_E_Lname"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="שם משפחה"
                        android:inputType="text"
                        android:textDirection="ltr"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:layoutDirection="rtl"
                        android:textSize="14sp"
                        android:fontFamily="@font/gevret_levin_alef" />

                </LinearLayout>

                <!-- כיתה -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_book"
                        android:layout_marginEnd="8dp" />

                    <Spinner
                        android:id="@+id/spstudent_kita"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:entries="@array/my_items"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:layoutDirection="rtl"
                        android:fontFamily="@font/gevret_levin_alef" />
                </LinearLayout>

                <!-- טלפון -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="16dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_phone"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/profile_student_E_phone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="מספר טלפון"
                        android:inputType="phone"
                        android:textDirection="ltr"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:layoutDirection="rtl"
                        android:textSize="14sp"
                        android:fontFamily="@font/gevret_levin_alef" />
                </LinearLayout>

                <!-- כפתור שמירה -->
                <Button
                    android:id="@+id/btnSaveprofile_student"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="שמור פרופיל"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/gevret_levin_alef"
                    android:backgroundTint="#1a7a9b"
                    android:stateListAnimator="@null" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
