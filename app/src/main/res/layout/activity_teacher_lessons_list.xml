<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screens.TeacherLessonsList">

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:text="רשימת השעורים שלי:"
        android:textColor="#63B3D3"
        android:textSize="30dp"
        app:layout_constraintBottom_toTopOf="@+id/rvThecherLessonList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvThecherLessonList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView9" />

    <!-- בדף עיצוב חייבים לכתוב את המידות בצורה כזאת כי אם לא זה שגיאה כי נגיד בכתיבה כמו שהיה עם
     x ו y זה טעות כי מדף לדף זה משתנה ואז יש שגיאה  -->
</androidx.constraintlayout.widget.ConstraintLayout>