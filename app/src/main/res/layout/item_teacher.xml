<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:background="@drawable/pic14"
  >





  <ImageView
      android:id="@+id/imageView2"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginTop="16dp"
      android:layout_weight="1"
      app:layout_constraintBottom_toTopOf="@+id/tvTeacherFName"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:srcCompat="@drawable/profil" />

  <TextView
      android:id="@+id/tvTeacherFName"
      android:layout_width="150dp"
      android:layout_height="0dp"
      android:layout_marginBottom="17dp"
      android:layout_weight="1"
      android:gravity="center"
      android:text="first name:"
      android:textStyle="bold"
      app:layout_constraintBottom_toTopOf="@+id/tvTeacherLName"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/imageView2" />

  <TextView
      android:id="@+id/tvTeacherLName"
      android:layout_width="150dp"
      android:layout_height="0dp"
      android:layout_marginBottom="17dp"
      android:layout_weight="1"
      android:gravity="center"
      android:text="last name:"
      android:textStyle="bold"
      app:layout_constraintBottom_toTopOf="@+id/tvTeacherprofession"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/tvTeacherFName" />

  <TextView
      android:id="@+id/tvTeacherclassteach"
      android:layout_width="145dp"
      android:layout_height="0dp"
      android:layout_marginBottom="21dp"
      android:layout_weight="1"
      android:gravity="center"
      android:text="class teach:"
      android:textStyle="bold"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/tvTeacherprofession" />

  <TextView
      android:id="@+id/tvTeacherprofession"
      android:layout_width="143dp"
      android:layout_height="0dp"
      android:layout_marginBottom="11dp"
      android:layout_weight="1"
      android:gravity="center"
      android:text="profession:"
      android:textStyle="bold"
      app:layout_constraintBottom_toTopOf="@+id/tvTeacherclassteach"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/tvTeacherLName" />

</androidx.constraintlayout.widget.ConstraintLayout>






