<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D7EEF4"
    tools:context=".screens.RegisterTeacherActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/imageView8"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/add"
                    android:padding="16dp" />

                <ImageButton
                    android:id="@+id/imageView9"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/add2" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="הרשמת מורה"
                android:textSize="20sp"
                android:textDirection="rtl"
                android:textStyle="bold"
                android:textColor="#1a5f78"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_person"
                        android:layout_marginEnd="8dp" />
                    <EditText
                        android:id="@+id/et_teacher_fname"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="שם פרטי"
                        android:inputType="text"
                        android:textDirection="ltr"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:layoutDirection="rtl"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_person"
                        android:layout_marginEnd="8dp" />
                    <EditText
                        android:id="@+id/et_teacher_lname"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="שם משפחה"
                        android:textDirection="ltr"
                        android:inputType="text"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:layoutDirection="rtl"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_phone"
                        android:layout_marginEnd="8dp" />
                    <EditText
                        android:id="@+id/et_teacher_phone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="טלפון"
                        android:inputType="phone"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:layoutDirection="rtl"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_email"
                        android:layout_marginEnd="8dp" />
                    <EditText
                        android:id="@+id/et_teacher_email"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textDirection="ltr"
                        android:hint="אימייל"
                        android:inputType="textEmailAddress"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:layoutDirection="rtl"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/outline_dialpad_24"
                        android:layout_marginEnd="8dp" />
                    <EditText
                        android:id="@+id/et_teacher_password"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="סיסמא"
                        android:inputType="textPassword"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:layoutDirection="rtl"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/outline_calendar_month_24"
                        android:layout_marginEnd="8dp" />
                    <EditText
                        android:id="@+id/et_teacher_age"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="גיל"
                        android:textDirection="ltr"
                        android:inputType="number"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:layoutDirection="rtl"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/outline_money_24"
                        android:layout_marginEnd="8dp" />
                    <EditText
                        android:id="@+id/et_teacher_price"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="מחיר"
                        android:inputType="numberDecimal"
                        android:background="@null"
                        android:textDirection="ltr"
                        android:gravity="end|center_vertical"
                        android:layoutDirection="rtl"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- מקצוע -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <Spinner
                        android:id="@+id/spSubject"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:entries="@array/Arrsubject"
                        android:background="@null"
                        android:layoutDirection="rtl" />
                </LinearLayout>

                <!-- מקצועות שנבחרו -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/etSubjects"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="מקצועות שנבחרו"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:layoutDirection="rtl"
                        android:textSize="14sp"
                        android:textColor="#1E5A7A" />
                </LinearLayout>

                <!-- זום -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <Spinner
                        android:id="@+id/spZoom"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:entries="@array/Arrzoom"
                        android:background="@null"
                        android:layoutDirection="rtl" />
                </LinearLayout>

                <!-- כיתות לימוד -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="16dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_book"
                        android:layout_marginEnd="8dp" />
                    <Spinner
                        android:id="@+id/et_teacher_teach_class"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:entries="@array/Arrgrade"
                        android:background="@null"
                        android:layoutDirection="rtl" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_register"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="הרשמה"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#1a7a9b"
                    android:stateListAnimator="@null" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>