<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D7EEF4"
    tools:context=".screens.RegisterStudentActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- תמונות לבחירת פרופיל -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="80dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- גלריה - ImageView לחיץ -->
                <ImageButton
                    android:id="@+id/student_register_gallery"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/gallery"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="גלריה" />

                <!-- מצלמה - ImageView לחיץ -->
                <ImageButton
                    android:id="@+id/student_register_camara"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/add"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="מצלמה" />

                <!-- תמונה שנבחרה -->
                <ImageView
                    android:id="@+id/iv_Rstudent"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@tools:sample/avatars" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="הרשמת תלמיד"
                android:layout_marginTop="20dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1a5f78"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="16dp">

                <!-- שם פרטי -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/input_background" android:layout_marginBottom="10dp"
                    android:paddingStart="12dp" android:paddingEnd="12dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_person" android:layout_marginEnd="8dp" />
                    <EditText android:id="@+id/et_student_fname"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:textDirection="ltr" android:hint="שם פרטי" android:inputType="text"
                        android:background="@null" android:gravity="end|center_vertical"
                        android:layoutDirection="rtl" android:textSize="14sp" />
                </LinearLayout>

                <!-- שם משפחה -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/input_background" android:layout_marginBottom="10dp"
                    android:paddingStart="12dp" android:paddingEnd="12dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_person" android:layout_marginEnd="8dp" />
                    <EditText android:id="@+id/et_student_lname"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:textDirection="ltr" android:hint="שם משפחה" android:inputType="text"
                        android:background="@null" android:gravity="end|center_vertical"
                        android:layoutDirection="ltr" android:textSize="14sp" />
                </LinearLayout>

                <!-- טלפון -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/input_background" android:layout_marginBottom="10dp"
                    android:paddingStart="12dp" android:paddingEnd="12dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_phone" android:layout_marginEnd="8dp" />
                    <EditText android:id="@+id/et_student_phone"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:textDirection="ltr" android:hint="טלפון" android:inputType="phone"
                        android:background="@null" android:gravity="end|center_vertical"
                        android:layoutDirection="rtl" android:textSize="14sp" />
                </LinearLayout>

                <!-- כיתה -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/input_background" android:layout_marginBottom="10dp"
                    android:paddingStart="12dp" android:paddingEnd="12dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_book" android:layout_marginEnd="8dp" />
                    <Spinner android:id="@+id/spstudent_kita"
                        android:layout_width="match_parent" android:textDirection="rtl"
                        android:layout_height="match_parent" android:entries="@array/my_items"
                        android:background="@null" android:gravity="end|center_vertical"
                        android:layoutDirection="rtl" android:textSize="14sp" />
                </LinearLayout>

                <!-- אימייל -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/input_background" android:layout_marginBottom="10dp"
                    android:paddingStart="12dp" android:paddingEnd="12dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_email" android:layout_marginEnd="8dp" />
                    <EditText android:id="@+id/et_student_email"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:textDirection="ltr" android:hint="אימייל"
                        android:inputType="textEmailAddress" android:background="@null"
                        android:gravity="end|center_vertical" android:layoutDirection="rtl"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- סיסמא -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/input_background" android:layout_marginBottom="16dp"
                    android:paddingStart="12dp" android:paddingEnd="12dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:tint="@color/black" android:src="@android:drawable/ic_lock_lock"
                        android:layout_marginEnd="8dp" />
                    <EditText android:id="@+id/et_student_password"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:textDirection="ltr" android:hint="סיסמא"
                        android:inputType="textPassword" android:background="@null"
                        android:gravity="end|center_vertical" android:layoutDirection="rtl"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- כפתור הרשמה -->
                <Button android:id="@+id/btn_register"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="הרשמה" android:textColor="@android:color/white"
                    android:textSize="16sp" android:backgroundTint="#1a7a9b"
                    android:stateListAnimator="@null" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>