<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pic6"
    tools:context=".screens.Addnewlesson">

    <!-- ספינר מקצועות - חדש -->

    <!-- שדה מקצוע (מתמלא אוטומטית מהספינר) -->

    <!-- תאריך -->

    <!-- שעה -->

    <!-- מחיר -->

    <!-- ספינר כיתות -->

    <Spinner
        android:id="@+id/sp_subject_addlesson"
        android:layout_width="146dp"
        android:layout_height="51dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="408dp"
        android:entries="@array/Arrsubject"
        android:textSize="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/subjectlesson_addlesson"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:layout_marginStart="27dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="42dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:fontFamily="@font/gevret_levin_alef"
        android:hint="מקצוע שיעור"
        android:textColor="#1E5A7A"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sp_subject_addlesson"
        app:layout_constraintTop_toBottomOf="@+id/etGradeClass" />

    <EditText
        android:id="@+id/et_datelesson_addlesson"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:layout_marginStart="209dp"
        android:layout_marginTop="198dp"
        android:layout_marginEnd="42dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:hint="תאריך השיעור"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- כיתה (מציג כיתות שנבחרו) -->

    <!-- צ'קבוקס זום -->

    <!-- כפתור הוספה -->

    <EditText
        android:id="@+id/et_timelesson_addlesson"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="42dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:hint="שעת השיעור (HH:mm)"
        android:inputType="time"
        android:textColor="#1E5A7A"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_datelesson_addlesson" />

    <EditText
        android:id="@+id/et_pricelesson_addlesson"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:layout_marginTop="29dp"
        android:layout_marginEnd="42dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:hint="מחיר לשיעור"
        android:inputType="numberDecimal"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subjectlesson_addlesson" />

    <Spinner
        android:id="@+id/sp_Class_addlesson"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="340dp"
        android:entries="@array/my_items"
        android:gravity="center"
        android:hint="דרך למידה"
        android:textColor="#1E5A7A"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etGradeClass"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="42dp"
        android:ems="10"
        android:fontFamily="@font/gevret_levin_alef"
        android:hint="כיתה"
        android:inputType="text"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_timelesson_addlesson" />

    <CheckBox
        android:id="@+id/ck_zoom"
        android:layout_width="255dp"
        android:layout_height="39dp"
        android:layout_marginStart="116dp"
        android:layout_marginTop="33dp"
        android:layout_marginEnd="40dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:hint="לשיעור בזום לחץ, אחרת השאר ריק"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_pricelesson_addlesson" />

    <Button
        android:id="@+id/button_addlesson"
        android:layout_width="101dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:layout_marginStart="161dp"
        android:layout_marginEnd="149dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/my_button_background"
        android:fontFamily="@font/nehama_webfont"
        android:text="הוסף שיעור"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


