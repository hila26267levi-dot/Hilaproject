<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pic10"
    tools:context=".screens.TeacherActivity">


    <TextView
        android:id="@+id/title_teacher_homepage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="97dp"
        android:layout_marginBottom="73dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:text="דף מורה"
        android:textSize="40dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_teacherpage_mylesson"
        app:layout_constraintStart_toStartOf="@+id/btn_teacherpage_mylesson"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_teacherpage_mylesson"
        android:layout_width="120dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginBottom="111dp"
        android:background="@drawable/my_button_background"
        android:fontFamily="@font/nehama_webfont"
        android:onClick="goMyLesson"
        android:text="השעורים שלי"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btn_teacher_myprofile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_teacher_homepage" />

    <Button
        android:id="@+id/btn_teacher_myprofile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginBottom="122dp"
        android:background="@drawable/my_button_background"
        android:fontFamily="@font/nehama_webfont"
        android:onClick="goMyProfile"
        android:text="הפרופיל שלי"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btn_teacher_addlesoon"
        app:layout_constraintEnd_toEndOf="@+id/title_teacher_homepage"
        app:layout_constraintStart_toStartOf="@+id/title_teacher_homepage"
        app:layout_constraintTop_toBottomOf="@+id/btn_teacherpage_mylesson" />

    <Button
        android:id="@+id/btn_teacher_addlesoon"
        android:layout_width="113dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginBottom="239dp"
        android:background="@drawable/my_button_background"
        android:fontFamily="@font/nehama_webfont"
        android:onClick="goAddLesson"
        android:text="הוספת שיעורים"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_teacher_myprofile" />

</androidx.constraintlayout.widget.ConstraintLayout>