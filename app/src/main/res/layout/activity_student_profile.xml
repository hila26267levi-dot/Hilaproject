<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screens.StudentProfile">


    <ImageView
        android:id="@+id/pic9"
        android:layout_width="467dp"
        android:layout_height="0dp"
        android:contentDescription="logo"
        android:src="@drawable/pic9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="-28dp" />

    <TextView
        android:id="@+id/tvProfileStudent_Fname"
        android:layout_width="224dp"
        android:layout_height="0dp"
        android:layout_marginBottom="81dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:gravity="center"
        android:text="TextView"
        android:textColor="#1E5A7A"
        app:layout_constraintBottom_toTopOf="@+id/tvProfileStudent_phone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_StudentProfile" />

    <TextView
        android:id="@+id/tvProfileStudent_Lname"
        android:layout_width="224dp"
        android:layout_height="82dp"
        android:layout_marginTop="82dp"
        android:layout_marginBottom="81dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:gravity="center"
        android:text="TextView"
        android:textColor="#1E5A7A"
        app:layout_constraintBottom_toBottomOf="@+id/tvProfileStudent_phone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvProfileStudent_Fname" />

    <TextView
        android:id="@+id/tvProfileStudent_phone"
        android:layout_width="224dp"
        android:layout_height="0dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:gravity="center"
        android:text="TextView"
        android:textColor="#1E5A7A"
        app:layout_constraintBottom_toTopOf="@+id/tvProfileStudent_class"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProfileStudent_Fname" />

    <ImageView
        android:id="@+id/img_StudentProfile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="75dp"
        android:layout_marginTop="98dp"
        android:layout_marginEnd="75dp"
        app:layout_constraintBottom_toTopOf="@+id/tvProfileStudent_Fname"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/profil" />

    <TextView
        android:id="@+id/tvProfileStudent_email"
        android:layout_width="224dp"
        android:layout_height="0dp"
        android:fontFamily="@font/gevret_levin_alef"
        android:gravity="center"
        android:text="TextView"
        android:textColor="#1E5A7A"
        app:layout_constraintBottom_toTopOf="@+id/btn_E_student_profile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProfileStudent_class" />

    <TextView
        android:id="@+id/tvProfileStudent_class"
        android:layout_width="224dp"
        android:layout_height="0dp"
        android:fontFamily="@font/nehama_webfont"
        android:gravity="center"
        android:text="TextView"
        android:textColor="#1E5A7A"
        app:layout_constraintBottom_toTopOf="@+id/tvProfileStudent_email"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProfileStudent_phone" />

    <Button
        android:id="@+id/btn_go_student_profile"
        android:layout_width="108dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginBottom="108dp"
        android:background="@drawable/my_button_background"
        android:fontFamily="@font/nehama_webfont"
        android:text="עריכת פרופיל "
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProfileStudent_email" />
</androidx.constraintlayout.widget.ConstraintLayout>